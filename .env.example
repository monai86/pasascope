# lingualens local demo
PASASCOPE_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
APP_MODE=mock
PASASCOPE_MOCK_MODE=true
PASASCOPE_AUTH_MODE=mock
PASASCOPE_SUPABASE_JWT_VERIFICATION_MODE=hs256_shared_secret
PASASCOPE_SUPABASE_JWT_SECRET=
PASASCOPE_SUPABASE_JWT_JWKS_JSON=
PASASCOPE_SUPABASE_JWT_JWKS_URL=
PASASCOPE_SUPABASE_JWT_JWKS_CACHE_TTL_SECONDS=300
PASASCOPE_SUPABASE_JWT_ISSUER=
PASASCOPE_SUPABASE_JWT_AUDIENCE=authenticated
PASASCOPE_SUPABASE_REQUIRE_MFA=true
PASASCOPE_SUPABASE_REQUIRE_INVITATION=true
PASASCOPE_DEBUG_FEATURE_OVERRIDE=false
PASASCOPE_REPOSITORY_MODE=json
PASASCOPE_JSON_REPOSITORY_PATH=.local/lingualens-app-repository.json
PASASCOPE_DATABASE_URL=postgresql+psycopg://therapist:therapist@localhost/therapist_app_v2
PASASCOPE_JOB_QUEUE_MODE=memory
PASASCOPE_STORAGE_MODE=local_private
# On-device speech recognition for uploaded recordings (needs faster-whisper
# from the root requirements.txt). Audio stays on this machine.
PASASCOPE_ASR_LOCAL_WHISPER_ENABLED=false
PASASCOPE_ASR_WHISPER_MODEL_SIZE=medium
PASASCOPE_ASR_LANGUAGE_STRATEGY=thai
PASASCOPE_LOCAL_STORAGE_ROOT=.local/storage
PASASCOPE_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PASASCOPE_CSRF_ORIGIN_GUARD_ENABLED=true
PASASCOPE_AI_REPORT_DRAFTING_ENABLED=false
PASASCOPE_RATE_LIMIT_ENABLED=false
PASASCOPE_RATE_LIMIT_REQUESTS=120
PASASCOPE_RATE_LIMIT_WINDOW_SECONDS=60
# Number of trusted reverse proxies in front of the API. 0 ignores X-Forwarded-For.
PASASCOPE_RATE_LIMIT_TRUSTED_PROXY_COUNT=0
PASASCOPE_OBSERVABILITY_ENABLED=false
PASASCOPE_OBSERVABILITY_PROVIDER=disabled
PASASCOPE_CRITICAL_ALERT_ROUTE=
PASASCOPE_SECRET_STORE_PROVIDER=local_env
PASASCOPE_CREDENTIAL_ROTATION_RUNBOOK=

# Legacy v2 env names remain supported temporarily for backward compatibility.

# Optional future services
POSTGRES_USER=therapist
POSTGRES_PASSWORD=therapist
POSTGRES_DB=therapist_app_v2
REDIS_URL=redis://redis:6379/0
